[Unit]
Description=D&D Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dndbot
WorkingDirectory=/opt/dnd_tg_bot
EnvironmentFile=/opt/dnd_tg_bot/.env
ExecStart=/opt/dnd_tg_bot/venv/bin/python /opt/dnd_tg_bot/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
